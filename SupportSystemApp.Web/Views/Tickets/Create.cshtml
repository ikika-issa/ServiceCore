@model SupportSystemApp.Domain.Domain.Ticket

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Ticket</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="RequesterId" class="control-label"></label>
                <select asp-for="RequesterId" class ="form-control" asp-items="ViewBag.RequesterId"></select>
            </div>


            <div class="form-group">
                <label asp-for="TicketStatusId" class="control-label"> Status </label>
                
                <select asp-for="TicketStatusId" 
                    class ="form-control" 
                    asp-items="ViewBag.TicketStatusId">
                </select>

                <span asp-validation-for="TicketStatusId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Priority" class="control-label"> Priority </label>
                
                <select asp-for="Priority" 
                    class ="form-control"
                    asp-items="ViewBag.Priority">
                </select>

                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TechnitianId" class="control-label">Technitian</label>

                <select asp-for="TechnitianId" 
                    class="form-control" 
                    asp-items="ViewBag.TechnitianId">
                </select>

                <span asp-validation-for="TechnitianId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Header" class="control-label"> Subject </label>
                <input asp-for="Header" class="form-control" />
                <span asp-validation-for="Header" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Details" class="control-label"> Description </label>
                <input asp-for="Details" class="form-control" />
                <span asp-validation-for="Details" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SiteId" class="control-label"></label>
                <select asp-for="SiteId" class ="form-control" asp-items="ViewBag.SiteId"></select>
            </div>

            <div class="form-group">
                <label asp-for="SupportGroupId" class="control-label">Group</label>
                
                <select asp-for="SupportGroupId" 
                    class="form-control" 
                    asp-items="ViewBag.SupportGroupId">
                </select>

                <span asp-validation-for="SupportGroupId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>

        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
