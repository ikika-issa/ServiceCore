@model SupportSystemApp.Domain.Domain.Ticket

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Ticket</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TicketNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TicketNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Header)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Header)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Details)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Details)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Priority)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Priority)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DueBy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DueBy)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ResolvedAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ResolvedAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OpenedBy)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OpenedBy!.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AssignedTo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AssignedTo!.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Site)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Site!.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SupportGroup)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SupportGroup!.Id)
        </dd>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Attachments</h5>
            </div>

            <div class="card-body">

                @if (Model.Attachments != null && Model.Attachments.Any())
                {
                    <table class="table table-bordered table-hover align-middle">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var attachment in Model.Attachments)
                            {
                                <tr>
                                    <td>
                                        📎 @attachment.FileName
                                    </td>

                                    <td>
                                        @(Math.Round(attachment.FileSize / 1024.0 / 1024.0, 2)) MB
                                    </td>

                                    <td>
                                        @attachment.UploadedAt.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <a asp-controller="Attachments"
                                           asp-action="Download"
                                           asp-route-id="@attachment.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Download
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <span class="text-muted">No attachments</span>
                }

            </div>
        </div>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
